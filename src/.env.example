# 3rD Lens Pipeline Environment Configuration Template
# Copy this file to .env and configure before starting the backend server

# JWT Secret for API token signing (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_hex_string_32_bytes

# Basic credentials for /api/auth/token endpoint
API_USERNAME=admin
API_PASSWORD=replace_with_a_secure_password

# Allowed origins for CORS (comma-separated, no spaces)
# Add your local frontend port and your production Vercel/Netlify domain
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app
